---
import '../styles/global.css';
import { SEO } from 'astro-seo';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  canonical?: string;
  noindex?: boolean;
}

const {
  title,
  description = 'The front door for AI implementation. Practitioners apply and get selected into real work. Customers buy proven outcomes, measured by a lab we run in public. Vendors get a partner of record.',
  ogImage = `${Astro.site}og-image.svg`,
  canonical,
  noindex = false,
} = Astro.props;

// Use explicit canonical if provided (syndicated content), otherwise generate from current URL
const canonicalURL = canonical || new URL(Astro.url.pathname, Astro.site).toString();

// Site-level structured data (emitted once on every page). Organization +
// WebSite establish the brand entity. sameAs lists the proof surfaces the
// homepage links to; every entry is a live property we control.
const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? 'https://intentsolutions.io';
const siteJsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: 'Intent Solutions',
    url: `${siteUrl}/`,
    logo: `${siteUrl}/favicon.svg`,
    sameAs: [
      'https://tonsofskills.com',
      'https://labs.intentsolutions.io',
      'https://learn.intentsolutions.io',
      'https://demos.intentsolutions.io',
      'https://github.com/intent-solutions-io',
      'https://github.com/jeremylongshore',
      'https://www.youtube.com/@intentsolutions',
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'Intent Solutions',
    url: `${siteUrl}/`,
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#f3f6f4" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- Fonts: self-hosted, preloaded, font-display: swap (declared in global.css).
         No stylesheet request to a font CDN at render time. -->
    <link rel="preload" href="/fonts/newsreader-500-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/inter-400-latin.woff2" as="font" type="font/woff2" crossorigin />

    <!-- SEO -->
    <SEO
      title={title}
      description={description}
      canonical={canonicalURL}
      noindex={noindex}
      nofollow={noindex}
      openGraph={{
        basic: {
          title: title,
          type: 'website',
          image: ogImage,
          url: canonicalURL,
        },
        optional: {
          description: description,
          siteName: 'Intent Solutions',
        }
      }}
      twitter={{
        card: 'summary_large_image',
        title: title,
        description: description,
        image: ogImage,
      }}
    />

    <!-- Site-level structured data (Organization + WebSite) -->
    <script type="application/ld+json" set:html={JSON.stringify(siteJsonLd)} />

    <!-- Umami analytics, self-hosted at analytics.intentsolutions.io. Page views
         are automatic; custom events come from data-umami-event attributes
         (convention: brand/analytics-events.md). -->
    <script
      defer
      src="https://analytics.intentsolutions.io/script.js"
      data-website-id="474bce85-f97d-409c-aba5-1e1ff36ee571"
      data-domains="intentsolutions.io"
    ></script>
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <slot />
  </body>
</html>

<style is:global>
  .skip-link {
    position: absolute;
    left: 1rem;
    top: -3rem;
    z-index: 100;
    padding: 0.5rem 0.75rem;
    background: var(--ink);
    color: var(--paper);
    border-radius: var(--radius);
    text-decoration: none;
  }
  .skip-link:focus {
    top: 1rem;
  }
</style>
