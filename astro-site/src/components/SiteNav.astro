---
// Header per the gateway brief (intent-os 165 section 6.4): wordmark; Learn,
// Labs, Catalog, Field Notes; a text link "Member sign in". No dropdowns, no
// booking CTA. Mobile gets the same five links under a text "Menu" toggle.
const links = [
  { href: 'https://learn.intentsolutions.io', label: 'Learn', event: 'nav-learn', external: true },
  { href: 'https://labs.intentsolutions.io', label: 'Labs', event: 'nav-labs', external: true },
  { href: 'https://demos.intentsolutions.io', label: 'Catalog', event: 'nav-catalog', external: true },
  { href: '/field-notes/', label: 'Field Notes', event: 'nav-field-notes', external: false },
];
const signIn = { href: 'https://learn.intentsolutions.io/user/login', label: 'Member sign in', event: 'member-signin' };
---

<header class="site-header">
  <nav class="container-is site-nav" aria-label="Primary">
    <a href="/" class="home-link" aria-label="Intent Solutions home">Intent Solutions</a>

    <div class="nav-links" id="nav-links">
      {links.map((l) => (
        <a
          href={l.href}
          class="nav-link"
          data-umami-event={l.event}
          rel={l.external ? 'noopener' : undefined}
        >{l.label}</a>
      ))}
      <a href={signIn.href} class="nav-link nav-link--signin" data-umami-event={signIn.event} rel="noopener">{signIn.label}</a>
    </div>

    <button type="button" class="nav-toggle" id="nav-toggle" aria-expanded="false" aria-controls="nav-links">Menu</button>
  </nav>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--paper);
    border-bottom: 1px solid var(--line);
  }
  .site-nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 4rem;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .nav-links {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }
  .nav-link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 0.75rem;
    color: var(--ink-dim);
    font-size: 0.9375rem;
    font-weight: 500;
    text-decoration: none;
    border-bottom: 2px solid transparent;
  }
  .nav-link:hover {
    color: var(--ink);
    border-bottom-color: var(--signal);
  }
  .nav-link--signin {
    margin-left: 0.75rem;
    color: var(--blueprint);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .nav-toggle {
    display: none;
    min-height: 44px;
    padding: 0 0.75rem;
    background: transparent;
    border: 1px solid var(--ink);
    border-radius: var(--radius);
    color: var(--ink);
    font: inherit;
    font-weight: 500;
  }
  @media (max-width: 767px) {
    .nav-toggle { display: inline-flex; align-items: center; }
    .nav-links {
      display: none;
      flex-basis: 100%;
      flex-direction: column;
      align-items: stretch;
      padding: 0.5rem 0 1rem;
      border-top: 1px solid var(--line);
    }
    .nav-links.is-open { display: flex; }
    .nav-link { padding: 0.25rem 0; border-bottom: 0; }
    .nav-link--signin { margin-left: 0; }
  }
</style>

<script>
  const toggle = document.getElementById('nav-toggle');
  const links = document.getElementById('nav-links');
  toggle?.addEventListener('click', () => {
    const open = links?.classList.toggle('is-open');
    toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
  });
</script>
