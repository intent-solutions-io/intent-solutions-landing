---
const network = [
  { href: 'https://intentsolutions.io/', label: 'Intent Solutions', active: true },
  { href: 'https://labs.intentsolutions.io/', label: 'Labs' },
  { href: 'https://evals.intentsolutions.io/', label: 'Evals' },
  { href: 'https://demos.intentsolutions.io/', label: 'Demos' },
  { href: 'https://learn.intentsolutions.io/', label: 'Learn' },
  { href: 'https://oma.intentsolutions.io/', label: 'Omarchy' },
];

const primary = [
  { href: '/#method', label: 'How we work' },
  { href: '/#proof', label: 'Proof' },
  { href: '/projects/', label: 'Projects' },
  { href: '/field-notes/', label: 'Field notes' },
  { href: '/about/', label: 'About' },
];
---

<nav class="network-bar" aria-label="Intent Solutions network">
  <div class="network-inner">
    {network.map(({ href, label, active }) => (
      <a href={href} aria-current={active ? 'page' : undefined}>{label}</a>
    ))}
  </div>
</nav>

<nav class="site-nav" aria-label="Primary navigation">
  <div class="nav-inner">
    <a href="/" class="brand" aria-label="Intent Solutions home">
      <img src="/images/logo-mark.png" alt="" width="28" height="28" aria-hidden="true" />
      <span>Intent <strong>Solutions</strong></span>
    </a>

    <div class="desktop-links">
      {primary.map(({ href, label }) => <a href={href}>{label}</a>)}
      <a class="nav-cta" href="/contact/?door=outcome">Request an outcome</a>
    </div>

    <details class="mobile-menu">
      <summary aria-label="Open navigation">Menu</summary>
      <div class="mobile-panel">
        {primary.map(({ href, label }) => <a href={href}>{label}</a>)}
        <a class="nav-cta" href="/contact/?door=outcome">Request an outcome</a>
      </div>
    </details>
  </div>
</nav>

<script>
  document.querySelectorAll<HTMLDetailsElement>('.mobile-menu').forEach((menu) => {
    const summary = menu.querySelector('summary');
    menu.addEventListener('click', (event) => {
      if ((event.target as Element).closest('a')) menu.open = false;
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && menu.open) {
        menu.open = false;
        summary?.focus();
      }
    });
    document.addEventListener('click', (event) => {
      if (!menu.contains(event.target as Node)) menu.open = false;
    });
  });
</script>

<style>
  .network-bar {
    background: #050506;
    border-bottom: 1px solid rgba(63, 63, 70, 0.52);
  }

  .network-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 1rem;
    width: min(72rem, calc(100% - 2rem));
    min-height: 2.15rem;
    margin: 0 auto;
    overflow-x: auto;
    scrollbar-width: none;
  }

  .network-inner::-webkit-scrollbar { display: none; }

  .network-inner a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    flex: 0 0 auto;
    color: #8b8b95;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.75rem;
    letter-spacing: 0.09em;
    text-decoration: none;
    text-transform: uppercase;
    transition: color 160ms ease;
  }

  .network-inner a:hover,
  .network-inner a:focus-visible { color: #fafafa; }

  .network-inner a[aria-current='page'] { color: #fb923c; text-decoration: underline; text-underline-offset: 0.35em; }

  .site-nav {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(9, 9, 11, 0.88);
    border-bottom: 1px solid rgba(63, 63, 70, 0.5);
    backdrop-filter: blur(18px);
  }

  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: min(72rem, calc(100% - 2rem));
    min-height: 4rem;
    margin: 0 auto;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    min-height: 44px;
    color: #fafafa;
    font-family: 'Syne', system-ui, sans-serif;
    font-size: 1rem;
    font-weight: 700;
    text-decoration: none;
  }

  .brand img { display: block; flex: 0 0 auto; }
  .brand strong { color: #ff7a1a; }

  .desktop-links {
    display: flex;
    align-items: center;
    gap: 1.45rem;
  }

  .desktop-links > a:not(.nav-cta),
  .mobile-panel > a:not(.nav-cta) {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: #a1a1aa;
    font-size: 0.84rem;
    font-weight: 500;
    text-decoration: none;
    transition: color 160ms ease;
  }

  .desktop-links > a:hover,
  .desktop-links > a:focus-visible,
  .mobile-panel > a:hover,
  .mobile-panel > a:focus-visible { color: #fafafa; }

  .nav-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 0.62rem 0.95rem;
    background: #f97316;
    border-radius: 0.45rem;
    color: #09090b;
    font-size: 0.8rem;
    font-weight: 800;
    text-decoration: none;
    transition: background 160ms ease, transform 160ms ease;
  }

  .nav-cta:hover,
  .nav-cta:focus-visible { background: #fb923c; transform: translateY(-1px); }

  .mobile-menu { display: none; position: relative; }

  .mobile-menu summary {
    min-width: 44px;
    min-height: 44px;
    padding: 0.8rem 0;
    color: #d4d4d8;
    cursor: pointer;
    font-size: 0.82rem;
    font-weight: 700;
    list-style: none;
    text-align: right;
  }

  .mobile-menu summary::-webkit-details-marker { display: none; }

  .mobile-panel {
    position: absolute;
    top: 3.2rem;
    right: 0;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    width: min(18rem, calc(100vw - 2rem));
    padding: 1.2rem;
    background: #101012;
    border: 1px solid #3f3f46;
    border-radius: 0.75rem;
  }

  .mobile-panel .nav-cta { margin-top: 0.25rem; text-align: center; }

  a:focus-visible,
  summary:focus-visible { outline: 2px solid #fb923c; outline-offset: 3px; }

  @media (max-width: 850px) {
    .desktop-links { display: none; }
    .mobile-menu { display: block; }
  }

  @media (max-width: 420px) {
    .network-inner { gap: 1rem; }
    .brand span { font-size: 0.92rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .network-inner a,
    .desktop-links a,
    .mobile-panel a { transition: none; }
  }
</style>
