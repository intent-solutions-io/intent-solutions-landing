---
// Static contact form. Posts JSON to the VPS forms-api at /api/forms/contact
// (Caddy routes /api/forms/* to 127.0.0.1:8090; the old React form posted to
// /api/contact, which nothing serves). The backend enum for `interest` is
// consulting | learn | colab | other; the ?door= query maps onto it so the
// three doors reach the same inbox without a backend change.
const doors = [
  { value: 'customer', label: 'Customer: request an outcome' },
  { value: 'vendor', label: 'Vendor: request partner-of-record' },
  { value: 'member', label: 'Member: a question before applying' },
  { value: 'other', label: 'Something else' },
];
---

<form id="contact-form" class="contact-form" method="post" action="/api/forms/contact" novalidate>
  <div class="field">
    <label for="door">I am writing as</label>
    <select id="door" name="door" required>
      {doors.map((d) => <option value={d.value}>{d.label}</option>)}
    </select>
  </div>

  <div class="field-row">
    <div class="field">
      <label for="name">Name</label>
      <input id="name" name="name" type="text" autocomplete="name" required />
    </div>
    <div class="field">
      <label for="email">Email</label>
      <input id="email" name="email" type="email" autocomplete="email" required />
    </div>
  </div>

  <div class="field">
    <label for="company">Company <span class="soft">(optional)</span></label>
    <input id="company" name="company" type="text" autocomplete="organization" />
  </div>

  <div class="field">
    <label for="message">What outcome, partnership, or question</label>
    <textarea id="message" name="message" rows="6" minlength="10" required></textarea>
    <p class="soft text-small">Say what you need done and how you will know it is done. We reply from jeremy@intentsolutions.io.</p>
  </div>

  <div class="hp" aria-hidden="true">
    <label for="website">Website</label>
    <input id="website" name="website" type="text" tabindex="-1" autocomplete="off" />
  </div>

  <div class="actions">
    <button type="submit" class="btn btn-primary" data-umami-event="contact-submit">Send</button>
    <p id="contact-status" class="text-small" role="status" aria-live="polite"></p>
  </div>
</form>

<style>
  .contact-form { display: flex; flex-direction: column; gap: 1.25rem; max-width: 40rem; }
  .field { display: flex; flex-direction: column; gap: 0.375rem; }
  .field-row { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
  label { font-size: 0.875rem; font-weight: 600; }
  input, select, textarea {
    width: 100%;
    padding: 0.625rem 0.75rem;
    background: var(--canvas);
    border: 1px solid var(--line-solid);
    border-radius: var(--radius);
    color: var(--ink);
    font: inherit;
    min-height: 44px;
  }
  textarea { min-height: 8rem; resize: vertical; }
  input:focus-visible, select:focus-visible, textarea:focus-visible { outline: 2px solid var(--signal); outline-offset: 1px; border-color: var(--ink); }
  .hp { position: absolute; left: -9999px; }
  .actions { display: flex; align-items: center; gap: 1rem; flex-wrap: wrap; }
  #contact-status:empty { display: none; }
  #contact-status.error { color: var(--signal-dark); }
  @media (max-width: 639px) { .field-row { grid-template-columns: 1fr; } }
</style>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const status = document.getElementById('contact-status') as HTMLElement | null;
  const doorSelect = document.getElementById('door') as HTMLSelectElement | null;

  const door = new URLSearchParams(location.search).get('door');
  if (door && doorSelect && [...doorSelect.options].some((o) => o.value === door)) doorSelect.value = door;

  const interestFor: Record<string, string> = { customer: 'consulting', member: 'learn', vendor: 'other', other: 'other' };

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!form.reportValidity()) return;
    const data = new FormData(form);
    const doorValue = String(data.get('door') || 'other');
    const button = form.querySelector('button[type=submit]') as HTMLButtonElement;
    button.disabled = true;
    if (status) { status.textContent = 'Sending'; status.classList.remove('error'); }
    try {
      const res = await fetch('/api/forms/contact', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          name: data.get('name'),
          email: data.get('email'),
          company: data.get('company') || undefined,
          interest: interestFor[doorValue],
          message: `[door: ${doorValue}] ${data.get('message')}`,
          website: data.get('website') || undefined,
        }),
      });
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      (window as any).umami?.track('contact-submit', { door: doorValue });
      location.assign('/thank-you/');
    } catch (err) {
      button.disabled = false;
      if (status) { status.textContent = 'That did not send. Email jeremy@intentsolutions.io directly.'; status.classList.add('error'); }
    }
  });
</script>
