---
import Layout from '../layouts/Layout.astro';
import SiteNav from '../components/SiteNav.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/home/Footer.astro';
---

<Layout
  title="Contact Intent Solutions"
  description="Request an outcome, request partner-of-record, or ask a question before applying. We reply from jeremy@intentsolutions.io."
>
  <SiteNav />
  <main id="main">
    <section class="section section--first">
      <div class="container-is">
        <p class="eyebrow">Contact</p>
        <h1 class="text-h1">Tell us what you need done.</h1>
        <p class="text-lede measure" style="margin-top:1rem">
          Customers request an outcome. Vendors request partner-of-record. Members apply at the learn site, and can ask a question here first. Nobody owes us a reply, a call, or a follow-up.
        </p>
      </div>
    </section>
    <section class="section">
      <div class="container-is">
        <Contact />
      </div>
    </section>
    <section class="section">
      <div class="container-is">
        <h2 class="text-h2">Other ways to reach us</h2>
        <dl class="reach">
          <div><dt>Email</dt><dd><a href="mailto:jeremy@intentsolutions.io">jeremy@intentsolutions.io</a></dd></div>
          <div><dt>Members</dt><dd><a href="https://learn.intentsolutions.io/request-access" rel="noopener" data-umami-event="door-member" data-umami-event-placement="contact">Request access at the learn site</a></dd></div>
          <div><dt>LinkedIn</dt><dd><a href="https://linkedin.com/in/jeremylongshore" rel="noopener" data-umami-event="outbound" data-umami-event-href="https://linkedin.com/in/jeremylongshore">/in/jeremylongshore</a></dd></div>
          <div><dt>Location</dt><dd>Gulf Shores, Alabama</dd></div>
        </dl>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  .reach { display: grid; grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr)); gap: 1.5rem; margin-top: 1.5rem; }
  .reach dt { font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--ink-faint); }
  .reach dd { margin: 0.25rem 0 0; }
</style>
