---
import Layout from '../../layouts/Layout.astro';
import SiteNav from '../../components/SiteNav.astro';
import Footer from '../../components/home/Footer.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('field-notes'))
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());

const title = 'Field Notes | Intent Solutions';
const description = 'The proof feed: what we shipped and what broke, written up as it happens.';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: 'Field Notes',
  description,
  url: 'https://intentsolutions.io/field-notes/',
  author: { '@type': 'Person', name: 'Jeremy Longshore' },
  publisher: { '@type': 'Organization', name: 'Intent Solutions', url: 'https://intentsolutions.io' },
};
---

<Layout title={title} description={description}>
  <SiteNav />
  <main id="main">
    <section class="section section--first">
      <div class="container-is">
        <p class="eyebrow">Field Notes</p>
        <h1 class="text-h1">The proof feed.</h1>
        <p class="text-lede measure" style="margin-top:1rem">{description}</p>

        <ul class="posts">
          {posts.map((post) => (
            <li class="post">
              <time datetime={post.data.date} class="font-mono post-date">{new Date(post.data.date).toISOString().slice(0, 10)}</time>
              <div>
                <a href={`/field-notes/${post.id.replace(/\.md$/, '')}/`} class="post-title">{post.data.title}</a>
                <p class="post-desc muted">{post.data.description}</p>
              </div>
            </li>
          ))}
        </ul>

        <p class="text-small" style="margin-top:2rem"><a href="/field-notes/rss.xml">RSS feed</a></p>
      </div>
    </section>
  </main>
  <Footer />
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</Layout>

<style>
  .posts { list-style: none; padding: 0; margin: 2.5rem 0 0; max-width: 52rem; }
  .post { display: grid; grid-template-columns: 7rem 1fr; gap: 1rem; padding: 1rem 0; border-top: 1px solid var(--line); }
  .post-date { font-size: 0.8125rem; color: var(--ink-faint); padding-top: 0.2rem; }
  .post-title { font-family: var(--font-display); font-size: 1.25rem; font-weight: 500; color: var(--ink); text-decoration: none; }
  .post-title:hover { color: var(--signal-dark); text-decoration: underline; }
  .post-desc { margin: 0.25rem 0 0; font-size: 0.9375rem; }
  @media (max-width: 639px) { .post { grid-template-columns: 1fr; gap: 0.25rem; } }
</style>
