---
import Layout from '../../layouts/Layout.astro';
import SiteNav from '../../components/SiteNav.astro';
import Footer from '../../components/home/Footer.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('field-notes');
  return posts.map(post => ({
    params: { slug: post.id.replace(/\.md$/, '') },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const isoDate = new Date(post.data.date).toISOString().slice(0, 10);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.date,
  author: { '@type': 'Person', name: 'Jeremy Longshore' },
  publisher: { '@type': 'Organization', name: 'Intent Solutions', url: 'https://intentsolutions.io' },
  mainEntityOfPage: post.data.canonical || `https://intentsolutions.io/field-notes/${post.id.replace(/\.md$/, '')}/`,
};
---

<Layout
  title={`${post.data.title} | Field Notes`}
  description={post.data.description}
  canonical={post.data.canonical}
>
  <SiteNav />
  <main id="main">
    <article class="section section--first">
      <div class="container-is article">
        <p class="text-small"><a href="/field-notes/">Field Notes</a></p>
        <header class="article-head">
          <p class="font-mono soft text-small"><time datetime={post.data.date}>{isoDate}</time>{post.data.tags?.length ? ` · ${post.data.tags.join(', ')}` : ''}</p>
          <h1 class="text-h1">{post.data.title}</h1>
          <p class="text-lede">{post.data.description}</p>
        </header>
        <div class="prose-field-notes">
          <Content />
        </div>
      </div>
    </article>
  </main>
  <Footer />
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</Layout>

<style>
  .article { max-width: 48rem; }
  .article-head { margin: 1.5rem 0 2.5rem; display: flex; flex-direction: column; gap: 0.75rem; }
</style>
