---
import Layout from '../layouts/Layout.astro';
import SiteNav from '../components/SiteNav.astro';
import Footer from '../components/home/Footer.astro';
---

<Layout
  title="Page not found | Intent Solutions"
  description="That page does not exist or has moved."
  noindex={true}
>
  <SiteNav />
  <main id="main">
    <section class="section section--first">
      <div class="container-is">
        <p class="eyebrow">404</p>
        <h1 class="text-h1">That page does not exist or has moved.</h1>
        <p class="measure" style="margin-top:1rem">The site was cut down to the front door in September 2026. What you were looking for is probably one of these.</p>
        <div class="actions">
          <a href="/" class="btn btn-primary">Front page</a>
          <a href="/field-notes/" class="btn btn-secondary">Field Notes</a>
          <a href="https://demos.intentsolutions.io" class="btn btn-secondary" rel="noopener">Catalog</a>
          <a href="/contact/" class="btn btn-secondary">Contact</a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  .actions { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 2rem; }
</style>
