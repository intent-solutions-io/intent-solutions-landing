---
// Paper-and-receipts framing. Team by role, no counts, no retired vendors.
import Layout from '../layouts/Layout.astro';
import SiteNav from '../components/SiteNav.astro';
import Footer from '../components/home/Footer.astro';

const roles = [
  { role: 'Founder', note: 'Holds the paper: every customer contract, vendor registration, and member agreement. Signs for the standard.' },
  { role: 'Engineering lead', note: 'Owns the house method as software: the audit harness, the evaluation lab, the deploy gates.' },
  { role: 'Delivery and program management', note: 'Runs engagements against the six rules and keeps the record an outsider can read.' },
  { role: 'Instruction', note: 'Teaches the method to admitted members at the learn site.' },
  { role: 'Regional operations (Germany)', note: 'Runs the German region under Intent Solutions paper; the template for the next region.' },
  { role: 'Software and design engineering', note: 'Builds the catalog outcomes and the surfaces you are reading.' },
];
---

<Layout
  title="About Intent Solutions"
  description="An AI implementation firm in Gulf Shores, Alabama that holds every relationship it delivers through and proves every piece of work in public."
>
  <SiteNav />
  <main id="main">
    <section class="section section--first">
      <div class="container-is">
        <p class="eyebrow">About</p>
        <h1 class="text-h1">A prime contractor with a guild behind it.</h1>
        <p class="text-lede measure" style="margin-top:1rem">
          Intent Solutions is an AI implementation firm in Gulf Shores, Alabama. Practitioners and small teams come through a door, learn the house method, and get selected into real work. Customers buy outcomes from us. Vendors get a partner of record. We hold every relationship, and we prove the work before we call it done.
        </p>
      </div>
    </section>

    <section class="section">
      <div class="container-is">
        <h2 class="text-h2">What we are not</h2>
        <p class="measure" style="margin-top:1rem">
          Not a system integrator: they own labor. Not a marketplace: it owns the listing, not the relationship. Not a staffing agency: it rents people. We hold the paper with the customer and the vendor, sell work as an outcome with a known shape, and decide who is in. Nobody gets rented out.
        </p>
      </div>
    </section>

    <section class="section">
      <div class="container-is">
        <h2 class="text-h2">How we prove it</h2>
        <p class="measure" style="margin-top:1rem">
          The method is six rules, each with a test a stranger can run, and the enforcement lives in the repositories, not in anyone's head. The evaluation lab grades our own work and publishes the pass and fail rows. The marketplace, the catalog of working demos, and the daily field notes are the record. All of it is linked from the <a href="/">front page</a> with the date each figure was last verified.
        </p>
      </div>
    </section>

    <section class="section">
      <div class="container-is">
        <h2 class="text-h2">The team, by role</h2>
        <dl class="roles">
          {roles.map((r) => (
            <div class="role">
              <dt>{r.role}</dt>
              <dd>{r.note}</dd>
            </div>
          ))}
        </dl>
        <p class="soft text-small" style="margin-top:1.5rem">Eight people across the United States and Europe. Members who deliver through us are named on their own work, never on a bench.</p>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  .roles { display: grid; grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr)); gap: 1.5rem 2rem; margin-top: 2rem; }
  .role { border-top: 1px solid var(--line); padding-top: 1rem; }
  .role dt { font-weight: 600; }
  .role dd { margin: 0.375rem 0 0; color: var(--ink-dim); }
</style>
