---
import Layout from '../layouts/Layout.astro';
import SiteNav from '../components/SiteNav.astro';
import Footer from '../components/Footer';

const responsibilities = [
  {
    title: 'The intent',
    body: 'We define the outcome, responsible team, authority, constraints, and failure boundary before work begins.',
  },
  {
    title: 'The system',
    body: 'We design the context, tools, handoffs, human control, and operating loop around the agent.',
  },
  {
    title: 'The evidence',
    body: 'We test the claim, retain the failures, and publish results that can be inspected and reproduced.',
  },
  {
    title: 'The operation',
    body: 'We account for ownership, observability, cost, rollback, and what happens when a component fails.',
  },
];

const team = [
  { name: 'Jeremy Longshore', role: 'Founder & CEO' },
  { name: 'Opeyemi Ariyo', role: 'Co-Founder & Chief Technical Officer' },
  { name: 'Pablo Perez', role: 'Co-Founder & Project Manager' },
  { name: 'Max Sheahan', role: 'Lead Instructor' },
  { name: 'Tim Neunzig', role: 'Head of German Operations' },
  { name: 'Tolulope Ariyo', role: 'Software & Design Engineer' },
];

const credentials = [
  {
    title: 'Claude Partner Badge · Claude Code',
    holder: 'Jeremy Longshore',
    issuer: 'Anthropic',
    embedUrl: 'https://www.credly.com/embedded_badge/ddf22fb4-0aa6-46b3-a93b-0b45b509e471',
    frameTitle: 'Claude Partner Badge for Claude Code, held by Jeremy Longshore and verified on Credly',
  },
];
---

<Layout
  title="About Intent Solutions"
  description="Intent Solutions is a team of builders, operators, and instructors who build, evaluate, teach, and run agentic systems."
>
  <SiteNav />

  <main class="about">
    <section class="about-hero">
      <div class="wrap narrow">
        <h1>A team stands behind the work.</h1>
        <p class="lede">
          Jeremy Longshore founded Intent Solutions. Today, our engineers, operators, instructors, and
          project leaders build and run agentic systems together—with written definitions of done and
          evidence that survives the demo.
        </p>
      </div>
    </section>

    <section class="section">
      <div class="wrap responsibility-grid">
        <div>
          <p class="kicker">What the name means</p>
          <h2>Intent Solutions is the brand, the practice, and the operating standard.</h2>
          <p>
            Models, providers, runtimes, protocols, and distribution channels are components.
            We choose them for the job. None of them becomes the identity of the company.
          </p>
        </div>
        <div class="responsibilities">
          {responsibilities.map((item) => (
            <article>
              <h3>{item.title}</h3>
              <p>{item.body}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="team" class="team section" aria-labelledby="team-title">
      <div class="wrap team-intro">
        <div class="section-head">
          <p class="kicker">Built by practitioners</p>
          <h2 id="team-title">The people in the operating loop.</h2>
          <p>
            The company is founder-led and team-built. These are the people shaping the systems,
            evaluations, delivery, and learning practice behind the Intent Solutions name.
          </p>
        </div>

        <div class="team-list">
          {team.map((member) => (
            <article>
              <h3>{member.name}</h3>
              <p>{member.role}</p>
            </article>
          ))}
        </div>

        <div class="credentials" aria-labelledby="credentials-title">
          <div class="credentials-head">
            <p class="kicker">Team credentials</p>
            <h3 id="credentials-title">Verified practice, kept in context.</h3>
            <p>
              Credentials support the work; they do not replace the evidence. This shelf can grow as
              the team earns and maintains additional partner credentials.
            </p>
          </div>
          <div class="credentials-list">
            {credentials.map((credential) => (
              <article class="credential-item">
                <iframe
                  src={credential.embedUrl}
                  width="150"
                  height="270"
                  loading="lazy"
                  title={credential.frameTitle}></iframe>
                <p><strong>{credential.title}</strong><span>{credential.holder} · Issued by {credential.issuer}</span></p>
              </article>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="network section">
      <div class="wrap">
        <div class="section-head">
          <p class="kicker">The public network</p>
          <h2>Separate rooms. One operating standard.</h2>
        </div>
        <div class="network-grid">
          <a href="https://labs.intentsolutions.io/">
            <span>Labs + Evals</span>
            <h3>The proof system</h3>
            <p>Labs publishes results. Evals defines what those results mean.</p>
          </a>
          <a href="https://demos.intentsolutions.io/">
            <span>Demos</span>
            <h3>The working catalog</h3>
            <p>Open systems, architecture walkthroughs, and representative outputs.</p>
          </a>
          <a href="https://learn.intentsolutions.io/">
            <span>Learn</span>
            <h3>The separate practice</h3>
            <p>Practitioners learn the method and work against production-shaped evidence.</p>
          </a>
          <a href="https://tonsofskills.com/">
            <span>Marketplace</span>
            <h3>The reusable tools</h3>
            <p>Plugins and agent skills that can be inspected before adoption.</p>
          </a>
        </div>
      </div>
    </section>

    <section class="close section">
      <div class="wrap narrow">
        <p class="kicker">Gulf Shores, Alabama</p>
        <h2>Bring the outcome. We will define the proof with you.</h2>
        <div class="actions">
          <a class="primary" href="/contact/?door=outcome">Request an outcome</a>
          <a class="secondary" href="https://labs.intentsolutions.io/results/">Inspect current results</a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  :global(body) { margin: 0; background: #09090b; }
  :global(*) { box-sizing: border-box; }
  .wrap { width: min(72rem, calc(100% - 2.5rem)); margin: 0 auto; }
  .narrow { max-width: 54rem; }
  .section { padding: clamp(5rem, 9vw, 8rem) 0; }
  .about-hero {
    padding: clamp(6rem, 12vw, 10rem) 0;
    background:
      linear-gradient(90deg, rgba(9,9,11,0.98), rgba(9,9,11,0.68)),
      url('/images/hero-about.jpg') center / cover no-repeat;
    border-bottom: 1px solid #3f3f46;
  }
  .kicker,
  .network-grid span { color: #fb923c; font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 0.66rem; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; }
  h1,
  h2,
  h3 { font-family: 'Syne', system-ui, sans-serif; }
  h1 { max-width: 50rem; margin: 1rem 0 1.5rem; color: #fafafa; font-size: clamp(3rem, 7vw, 5.8rem); line-height: 0.98; letter-spacing: -0.05em; }
  h2 { margin: 0.8rem 0 1rem; color: #fafafa; font-size: clamp(2rem, 4vw, 3.2rem); line-height: 1.1; letter-spacing: -0.035em; }
  .lede { max-width: 46rem; color: #d4d4d8; font-size: clamp(1.05rem, 2vw, 1.3rem); line-height: 1.75; }
  .responsibility-grid { display: grid; grid-template-columns: minmax(18rem, 0.8fr) minmax(0, 1.2fr); gap: clamp(3rem, 8vw, 8rem); }
  .responsibility-grid > div:first-child > p:last-child { color: #a1a1aa; line-height: 1.75; }
  .responsibilities { border-top: 1px solid #3f3f46; }
  .responsibilities article { padding: 1.4rem 0; border-bottom: 1px solid #3f3f46; }
  .responsibilities h3 { margin: 0 0 0.45rem; color: #fafafa; font-size: 1.15rem; }
  .responsibilities p { margin: 0; color: #a1a1aa; font-size: 0.9rem; line-height: 1.7; }
  .team { background: #09090b; }
  .team-intro > .section-head > p:last-child { max-width: 47rem; color: #a1a1aa; line-height: 1.75; }
  .team-list { display: grid; grid-template-columns: repeat(3, 1fr); border-top: 1px solid #3f3f46; }
  .team-list article { min-height: 8.5rem; padding: 1.5rem 1.25rem 1.5rem 0; border-bottom: 1px solid #3f3f46; }
  .team-list article:not(:nth-child(3n + 1)) { padding-left: 1.25rem; border-left: 1px solid #3f3f46; }
  .team-list h3 { margin: 0 0 0.45rem; color: #fafafa; font-size: 1.05rem; }
  .team-list p { margin: 0; color: #a1a1aa; font-size: 0.82rem; line-height: 1.5; }
  .credentials { margin-top: 3.5rem; padding: 1.75rem; background: #101012; border: 1px solid #3f3f46; border-radius: 0.8rem; }
  .credentials h3 { margin: 0.7rem 0; color: #fafafa; font-size: 1.35rem; }
  .credentials-head > p:last-child { max-width: 42rem; margin: 0; color: #a1a1aa; font-size: 0.88rem; line-height: 1.7; }
  .credentials-list { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(19rem, 100%), 1fr)); gap: 1rem; margin-top: 1.5rem; padding-top: 1.5rem; border-top: 1px solid #3f3f46; }
  .credential-item { display: flex; align-items: center; gap: 1rem; min-width: 0; }
  .credential-item iframe { flex: 0 0 auto; border: 0; }
  .credential-item p { display: flex; flex-direction: column; gap: 0.35rem; margin: 0; color: #d4d4d8; font-size: 0.78rem; line-height: 1.45; }
  .credential-item strong { color: #fafafa; font-size: 0.86rem; }
  .credential-item span { color: #8b8b95; }
  .network { background: #101012; border-top: 1px solid #3f3f46; border-bottom: 1px solid #3f3f46; }
  .section-head { max-width: 50rem; margin-bottom: 3rem; }
  .network-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem; }
  .network-grid a { min-height: 18rem; padding: 1.5rem; background: #18181b; border: 1px solid #3f3f46; border-radius: 0.8rem; color: inherit; text-decoration: none; transition: border-color 160ms ease, transform 160ms ease; }
  .network-grid a:hover,
  .network-grid a:focus-visible { border-color: #fb923c; transform: translateY(-2px); }
  .network-grid h3 { margin: 1.4rem 0 0.7rem; color: #fafafa; font-size: 1.3rem; }
  .network-grid p { margin: 0; color: #a1a1aa; font-size: 0.9rem; line-height: 1.7; }
  .close { text-align: center; }
  .close .narrow { display: flex; align-items: center; flex-direction: column; }
  .actions { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.8rem; margin-top: 1rem; }
  .actions a { padding: 0.8rem 1.15rem; border: 1px solid transparent; border-radius: 0.48rem; font-size: 0.85rem; font-weight: 800; text-decoration: none; }
  .actions .primary { background: #f97316; color: #09090b; }
  .actions .secondary { border-color: #52525b; color: #fafafa; }
  a:focus-visible { outline: 2px solid #fb923c; outline-offset: 4px; }
  @media (max-width: 800px) {
    .responsibility-grid,
    .network-grid { grid-template-columns: 1fr; }
    .team-list { grid-template-columns: 1fr 1fr; }
    .team-list article:not(:nth-child(3n + 1)) { padding-left: 0; border-left: 0; }
    .team-list article:nth-child(even) { padding-left: 1.25rem; border-left: 1px solid #3f3f46; }
    .credentials { grid-template-columns: 1fr; }
    .credential-item { min-width: 0; }
    .network-grid a { min-height: 13rem; }
  }
  @media (max-width: 520px) {
    .team-list { grid-template-columns: 1fr; }
    .team-list article:nth-child(even) { padding-left: 0; border-left: 0; }
    .credential-item { align-items: flex-start; flex-direction: column; }
  }
  @media (prefers-reduced-motion: reduce) { .network-grid a { transition: none; } }
</style>
