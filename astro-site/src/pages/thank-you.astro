---
import Layout from '../layouts/Layout.astro';
import SiteNav from '../components/SiteNav.astro';
import Footer from '../components/home/Footer.astro';
---

<Layout title="Received | Intent Solutions" description="Your message reached us." noindex={true}>
  <SiteNav />
  <main id="main">
    <section class="section section--first">
      <div class="container-is">
        <p class="eyebrow">Received</p>
        <h1 class="text-h1">Your message reached us.</h1>
        <p class="measure" style="margin-top:1rem">A reply comes from jeremy@intentsolutions.io. If you do not see one, check the spam folder, then write to that address directly.</p>
        <div style="margin-top:2rem"><a href="/" class="btn btn-primary">Back to the front page</a></div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
