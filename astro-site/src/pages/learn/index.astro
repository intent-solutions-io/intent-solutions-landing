---
import Layout from '../../layouts/Layout.astro';
import SiteNav from '../../components/SiteNav.astro';
import Footer from '../../components/Footer';
---

<Layout
  title="Intent Solutions Learn"
  description="Intent Solutions Learn is the separate practice where practitioners learn the operating method behind our agentic systems."
  canonical="https://learn.intentsolutions.io/"
  noindex={true}
>
  <SiteNav />

  <main class="handoff">
    <section>
      <div class="handoff-copy">
        <p class="kicker">Intent Solutions Learn</p>
        <h1>Learn has its own room.</h1>
        <p class="lede">
          Learn is the separate Intent Solutions practice for serious builders. It teaches the house
          method. Intent Labs publishes the evidence. Evals defines what each result means.
        </p>
        <div class="relationship" aria-label="Learn and Labs relationship">
          <div><span>Practice</span><strong>Learn the method in Learn</strong></div>
          <span aria-hidden="true">→</span>
          <div><span>Proof</span><strong>Inspect the method in Labs</strong></div>
        </div>
        <div class="actions">
          <a class="primary" href="https://learn.intentsolutions.io/">Visit Intent Solutions Learn</a>
          <a class="secondary" href="https://labs.intentsolutions.io/start/">See how we evaluate</a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  :global(body) { margin: 0; background: #09090b; }
  .handoff { min-height: 70vh; display: grid; place-items: center; background: linear-gradient(120deg, rgba(9,9,11,0.97), rgba(9,9,11,0.7)), url('/images/learn-hero-bg.jpg') center / cover no-repeat; }
  .handoff section { width: min(100% - 2rem, 62rem); padding: 7rem 0; }
  .handoff-copy { max-width: 52rem; }
  .kicker,
  .relationship span { color: #fb923c; font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 0.66rem; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; }
  h1 { margin: 1rem 0 1.5rem; color: #fafafa; font-family: 'Syne', system-ui, sans-serif; font-size: clamp(3rem, 8vw, 6rem); letter-spacing: -0.055em; line-height: 0.98; }
  .lede { max-width: 48rem; color: #d4d4d8; font-size: clamp(1rem, 2vw, 1.25rem); line-height: 1.75; }
  .relationship { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 1rem; margin: 2.5rem 0; padding: 1rem; background: rgba(9,9,11,0.72); border: 1px solid #3f3f46; border-radius: 0.8rem; backdrop-filter: blur(12px); }
  .relationship div { padding: 0.8rem; }
  .relationship div span { display: block; margin-bottom: 0.4rem; }
  .relationship strong { color: #fafafa; font-size: 0.9rem; }
  .relationship > span { color: #71717a; font-size: 1rem; }
  .actions { display: flex; flex-wrap: wrap; gap: 0.8rem; }
  .actions a { padding: 0.8rem 1.15rem; border: 1px solid transparent; border-radius: 0.48rem; font-size: 0.85rem; font-weight: 800; text-decoration: none; }
  .primary { background: #f97316; color: #09090b; }
  .secondary { background: rgba(9,9,11,0.5); border-color: #52525b !important; color: #fafafa; }
  a:focus-visible { outline: 2px solid #fb923c; outline-offset: 4px; }
  @media (max-width: 640px) {
    .relationship { grid-template-columns: 1fr; }
    .relationship > span { transform: rotate(90deg); text-align: center; }
  }
</style>
