{
  "name": "astro-site",
  "type": "module",
  "version": "3.0.0",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "receipts": "node scripts/refresh-receipts.mjs",
    "receipts:check": "node scripts/refresh-receipts.mjs --check",
    "audit:indexability": "node scripts/audit-indexability.mjs",
    "check:copy": "node scripts/check-copy.mjs",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "gate": "npm run build && npm run audit:indexability && npm run check:copy && npm run receipts:check"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.17",
    "@astrojs/sitemap": "^3.7.2",
    "@tailwindcss/vite": "^4.1.14",
    "astro": "^5.14.1",
    "astro-seo": "^0.8.4",
    "tailwindcss": "^4.1.14"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0"
  }
}
